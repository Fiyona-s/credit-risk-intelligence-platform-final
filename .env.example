# LLM provider for talk-to-data chatbot. Free-tier only.
# Groq is tried first (fast, generous free rate limits). Falls back to Gemini if GROQ_API_KEY is unset.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Fallback provider if Groq is unavailable
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Risk band thresholds (probability of default), used by predict.py
RISK_THRESHOLD_LOW=0.10
RISK_THRESHOLD_MEDIUM=0.30

# Cost-sensitive threshold selection: relative cost of a false positive (wrongly
# flagging a good applicant, e.g. extra manual review) vs. a false negative (missing
# an actual defaulter). FN_COST > FP_COST by default since missing a defaulter is
# assumed costlier. src/ml/train.py sweeps thresholds 0.1-0.9 to find the one that
# minimizes FP_COST*false_positives + FN_COST*false_negatives, saved to
# models/optimal_threshold.json. The Risk Prediction tab lets you try other ratios
# interactively without retraining.
FP_COST=1
FN_COST=5

# Paths (defaults are fine for Docker; override for local runs if needed)
DATA_DIR=data
MODELS_DIR=models

# Talk-to-data safety
MAX_QUERY_ROWS=200

# OPTIONAL, deployment only: a Postgres connection string (e.g. from Render's free
# Postgres add-on) pre-loaded with the real dataset via scripts/load_dataset_to_postgres.py.
# The dataset itself is never committed to this repo. DuckDB attaches this database
# live via its postgres extension — no download, no re-fetch on cold start. Leave
# unset to use the real local CSV if present, or the synthetic fallback otherwise
# (default behavior, no setup needed).
POSTGRES_URL=

# ---- Milestone 8: data engineering / cloud platform layer (src/pipeline/*) ----
# Entirely OPTIONAL. Leaving everything below unset means `python -m
# src.pipeline.pipeline --source local` still works fully (Parquet output,
# local metadata), and the Streamlit/FastAPI app is completely unaffected
# either way — none of this is read by the app itself.

# "local" (default) reads data/*.csv directly, no AWS credentials needed.
# "s3" additionally stages raw inputs/curated output/metadata to S3.
DATA_SOURCE=local

# Only needed when DATA_SOURCE=s3. AWS credentials themselves are NEVER read
# from this file — they come from the normal AWS credential chain (environment
# variables, ~/.aws/credentials, an IAM role, etc.), per AWS/boto3 convention.
AWS_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=credit-risk-platform

# OPTIONAL: a separate Postgres connection string for the pipeline's own
# analytical `applicant_features` table (src/pipeline/postgres_loader.py) —
# deliberately independent of POSTGRES_URL above, which only backs the
# chatbot's live-Postgres read path. May point at the same physical database
# if convenient; the two features never depend on each other.
DATABASE_URL=
