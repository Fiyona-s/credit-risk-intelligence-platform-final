# Real Kaggle dataset - never commit any of these
data/application_train.csv
data/application_test.csv
data/bureau.csv
data/bureau_balance.csv
data/credit_card_balance.csv
data/installments_payments.csv
data/previous_application.csv
data/POS_CASH_balance.csv
data/*.zip

# keep the synthetic fallback used by the deployed chatbot demo
!data/sample_applicants.csv

# Secrets
.env

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# OS
.DS_Store

# Monitoring artifacts (regenerated by src/ml/train.py --monitor and the
# Monitoring tab; large, environment/run-specific, not meant to be versioned)
reports/*.html
reports/*.parquet

# Model card (regenerated by scripts/generate_model_card.py / the Model
# Evaluation tab's Download Model Card button; run-specific, not versioned)
reports/*.pdf

# Data validation report (regenerated by src/ml/train.py on every training run
# via src/data/validation.py; run-specific, not versioned)
reports/*.md

# Model comparison artifact + experiment log (regenerated by
# src/ml/model_comparison.py; run-specific, not versioned)
reports/*.json

# Candidate model artifacts from src/ml/model_comparison.py — large binaries,
# reproducible by rerunning the comparison; only the deployed
# models/credit_risk_model.joblib is committed
models/*_candidate.joblib

# Probability calibrator + calibration report/plot (regenerated by
# src/ml/calibration.py; run-specific, not versioned)
models/probability_calibrator.joblib
models/calibration_metadata.json
reports/*.png

# Business decision threshold artifact (regenerated by
# src/ml/decision_optimization.py; run-specific, not versioned). The legacy
# models/optimal_threshold.json (raw-probability, Milestone 1) is unaffected
# and stays whatever its own existing tracking policy already was.
models/decision_threshold.json

# Milestone 8 data pipeline local outputs (regenerated by
# src/pipeline/pipeline.py; run-specific batch artifacts, not versioned)
curated_data/
metadata/
